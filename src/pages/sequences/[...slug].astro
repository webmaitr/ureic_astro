---
import {getCollection, render} from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';


export async function getStaticPaths() {
	const courses = await getCollection('sequence');
	return courses.map(cours => ({
		params: { slug: cours.id },
		props: {cours},
	}));
}

const {cours} = Astro.props;
const {Content} = await render(cours);
---

<CourseLayout frontmatter={cours.data}>
  <h1>{cours.data.title}</h1>
<Content />
</CourseLayout>