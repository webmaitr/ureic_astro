---
import {site} from '../consts'
import Navigation from './Navigation.astro'

---

<header>
  <a href="/">
  <img class="site-logo" src="/logo_template.svg" alt="Nom du site" width="151" height="156" />
</a>
  <div class="site-title">
    <p>{site.title}</p>
  <p>{site.slogan}</p>
  </div>
    <Navigation />

</header>

<style>
  @layer components {
    header {
      border-bottom: 1px solid var(--color-border);
      .site-title {
        flex: 1;
      }
      site-logo {
        .logo-infini {
          fill:#fff;
        }
        
      }
    }
  }
</style>