---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
---

<script>
  import * as CookieConsent from 'vanilla-cookieconsent';

  const initCookieConsent = () => {
    CookieConsent.run({
      // Supprime automatiquement les cookies GA si la catégorie 'analytics' est décochée
      manageScriptTags: true,
      autoClearCookies: true,

      guiOptions: {
        consentModal: {
          layout: 'box',
          position: 'bottom right',
        },
        preferencesModal: {
          layout: 'box',
        },
      },

      categories: {
        necessary: {
          enabled: true,
          readOnly: true,
        },
        analytics: {
          enabled: false,
          // Suppression automatique des cookies Google Analytics en cas de refus/révocation
          autoClear: {
            cookies: [
              { name: /^_ga/ }, // Supprime _ga et _ga_XXXXXXXXXX
              { name: '_gid' },
            ],
          },
        },
      },

      // Si l'utilisateur révoque 'analytics' après l'avoir accepté, on recharge la page
      // pour décharger le script gtag de la mémoire du navigateur
      onChange: ({ changedCategories }) => {
        if (changedCategories.includes('analytics') && !CookieConsent.acceptedCategory('analytics')) {
          window.location.reload();
        }
      },

      language: {
        default: 'fr',
        translations: {
          fr: {
            consentModal: {
              title: 'Gestion des cookies',
              description:
                'Nous utilisons des cookies pour assurer le bon fonctionnement du site et, avec votre accord, mesurer notre audience via Google Analytics.',
              acceptAllBtn: 'Tout accepter',
              acceptNecessaryBtn: 'Tout refuser',
              showPreferencesBtn: 'Personnaliser',
            },
            preferencesModal: {
              title: 'Préférences de confidentialité',
              acceptAllBtn: 'Tout accepter',
              acceptNecessaryBtn: 'Tout refuser',
              savePreferencesBtn: 'Enregistrer mes choix',
              sections: [
                {
                  title: 'Cookies strictement nécessaires',
                  description: 'Indispensables au fonctionnement technique du site et à la mémorisation de vos choix.',
                  linkedCategory: 'necessary',
                },
                {
                  title: 'Mesure d’audience (Google Analytics)',
                  description: 'Permet d’analyser la fréquentation et l’utilisation du site de manière statistique.',
                  linkedCategory: 'analytics',
                },
              ],
            },
          },
        },
      },
    });
  };

  initCookieConsent();
  document.addEventListener('astro:after-swap', initCookieConsent);
</script>